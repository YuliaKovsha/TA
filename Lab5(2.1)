# Створення списку
L = [3, 1, 4, 1, 5]
print("Початковий список:", L)

# Доступ до елементів
print("Перший елемент:", L[0])

# Додавання елементів
L.append(9)
L.extend([2, 6])
L.insert(2, 7)
print("Після додавання:", L)

# Видалення елементів
L.remove(1)
deleted = L.pop(3)
del L[1]
print("Після видалення:", L)

# Сортування та реверс
L.sort()
print("Відсортований список:", L)
L.reverse()
print("У зворотному порядку:", L)

# Довжина списку
print("Довжина списку:", len(L))

# Слайсинг
print("Середні елементи:", L[1:4])
print("Кожен другий елемент:", L[::2])

# Перетворення
T = tuple(L)
S = set(L)
print("Як кортеж:", T)
print("Як множина:", S)
