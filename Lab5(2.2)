# Створення
t = (1, 2, 3, 4)
print("Кортеж:", t)

# Доступ до елементів
print("Другий елемент:", t[1])

# Незмінність
try:
    t[1] = 9
except TypeError:
    print("Кортеж — незмінюваний тип!")

# Операції
print("Додавання кортежів:", t + (5, 6))
print("Повторення:", t * 2)

# Методи
print("Кількість двійок:", t.count(2))
print("Індекс елемента 4:", t.index(4))

# Перетворення
t_list = list(t)
print("Перетворено у список:", t_list)
t_back = tuple(t_list)
print("Повернено у кортеж:", t_back)
