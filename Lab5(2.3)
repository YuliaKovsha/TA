# Створення множини
A = {1, 2, 3, 4}
B = set([3, 4, 5, 6])
print("A =", A)
print("B =", B)

# Додавання / видалення
A.add(10)
A.discard(2)
print("Після змін:", A)

# Операції (методи)
print("Об’єднання:", A.union(B))
print("Перетин:", A.intersection(B))
print("Різниця:", A.difference(B))
print("Симетрична різниця:", A.symmetric_difference(B))

# Операції (оператори)
print("Об’єднання (|):", A | B)
print("Перетин (&):", A & B)
print("Різниця (-):", A - B)
print("Симетрична різниця (^):", A ^ B)

# Підмножини та надмножини
print("A підмножина B?", A < B)
print("A надмножина B?", A > B)

# Перетворення
print("Як список:", list(A))
print("Як множина знову:", set(list(A)))
